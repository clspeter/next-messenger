# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored; never commit real secrets. This template is safe to commit.

# ─── Database (MongoDB) ──────────────────────────────────────────────
# Read by Prisma datasource in prisma/schema.prisma (env("DATABASE_URL")).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority"

# ─── NextAuth ────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Required in production; local dev auto-infers http://localhost:3000
# NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth providers ─────────────────────────────────────────────────
# Optional for local smoke testing — you can test login/register with the
# Credentials (email + password) provider without these. For OAuth locally,
# set the provider's callback URL to http://localhost:3000/api/auth/callback/<provider>.
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Pusher (realtime) ───────────────────────────────────────────────
# NOTE: the app code reads PUSHER_APP_ID, falling back to the legacy
# misspelled PUHSER_APP_ID for backward compatibility. Use PUSHER_APP_ID.
# Cluster is hard-coded to 'ap3' in app/libs/pusher.ts.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_APP_KEY=""

# ─── Cloudinary (avatar / image upload) ──────────────────────────────
# Required by <CldUploadButton> (next-cloudinary). The upload preset is
# hard-coded to 'c2hjkj0d' in the components.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
